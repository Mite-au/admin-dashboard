# ---------------------------------------------------------------------------
# Alpha-backend profile for LOCAL admin-dashboard development.
#
# Point your local `npm run dev` server at the deployed alpha backend by
# copying this file to `.env.local` (which is gitignored), then restart dev:
#
#     cp .env.alpha.local.example .env.local
#     npm run dev
#
# Why this is safe from localhost
# -------------------------------
# admin-dashboard uses a Backend-for-Frontend (BFF) pattern. The browser only
# ever talks to THIS Next.js app (same origin). Every call to the NestJS
# backend happens server-side:
#   * login       -> src/app/api/login/route.ts  (POST /auth/admin/login)
#   * page reads  -> src/lib/api.ts via src/lib/fetchers.ts (GET /admin/*)
#   * mutations   -> src/lib/actions.ts server actions
# Because those calls are server-to-server, there is no browser CORS step, and
# the session cookie (`admin_token`) is minted first-party by this app on the
# localhost origin — so the alpha backend's own cookie domain / SameSite /
# Secure settings do NOT affect local login. In `next dev` the cookie is set
# with Secure=false (NODE_ENV=development), so it persists over http://localhost.
#
# The only backend URL this app reads is NEXT_PUBLIC_API_BASE_URL below. There
# is no socket/websocket usage in admin-dashboard, so no SOCKET URL is needed.
# ---------------------------------------------------------------------------

# Base URL of the NestJS backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://alpha.api.gdaymite.com
